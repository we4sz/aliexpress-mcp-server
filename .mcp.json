{
  "mcpServers": {
    "aliexpress": {
      "command": "uv",
      "args": [
        "run",
        "--with", "mcp<2",
        "--with", "httpx",
        "--with", "beautifulsoup4",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/aliexpress_mcp_server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "ALIEXPRESS_COUNTRY": "CA",
        "ALIEXPRESS_CURRENCY": "CAD"
      }
    }
  }
}
